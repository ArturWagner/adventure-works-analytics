# ============================================================
# Airflow
# ============================================================
AIRFLOW_UID=50000

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=<gere_e_substitua>

# String aleatória qualquer
AIRFLOW__CORE__SECRET_KEY=<string_aleatoria>

# Credenciais da UI do Airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ============================================================
# Postgres (banco de metadados do Airflow)
# ============================================================
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# ============================================================
# SQL Server
# Requisitos de senha: mínimo 8 chars, maiúscula, minúscula, número e símbolo
# Exemplo: MinhaSenh@123
# ============================================================
MSSQL_SA_PASSWORD=<senha_forte_aqui>
ACCEPT_EULA=Y
